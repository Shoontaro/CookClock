<div class="timer-wrapper">

    <div class="progress-ring"
         style="@RingStyle">

        <div class="inner-circle">

            <div class="egg-icon">🥚</div>

            <div class="time">
                @FormattedTime
            </div>

        </div>
    </div>

</div>

@code {
    [Parameter] public int TotalSeconds { get; set; }
    [Parameter] public int RemainingSeconds { get; set; }

    private double Radius => 90;

    private double Circumference =>
        2 * Math.PI * Radius;

    private double Progress =>
        TotalSeconds == 0
            ? 0
            : (double)RemainingSeconds / TotalSeconds;

    private double StrokeOffset =>
        Circumference * (1 - Progress);

    private double ProgressPercent =>
   TotalSeconds == 0
       ? 0
       : (double)RemainingSeconds /
         TotalSeconds * 100;

    private string RingStyle =>
$"background: conic-gradient(" +
$"#FFB703 {ProgressPercent}%, " +
$"#2A2A2A {ProgressPercent}%);";

    private string FormattedTime =>
        TimeSpan.FromSeconds(RemainingSeconds)
            .ToString(@"mm\:ss");
}
